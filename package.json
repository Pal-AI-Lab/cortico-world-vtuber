{
  "name": "cortico-world-vtuber",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico World: Live2D VTuber performance — VTube Studio wiring, streaming TTS, forced alignment, subtitle overlay",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "cortico-world",
    "cortico",
    "vtuber",
    "live2d",
    "vtube-studio",
    "tts"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 5,
    "consoleClient": "dist/console.js",
    "consoleStyle": "dist/console.css"
  },
  "files": [
    "src",
    "!src/voxcpm2-server",
    "dist",
    "scripts",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-console.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "audify": "^1.10.1",
    "fflate": "^0.8.3",
    "tar-stream": "^3.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
